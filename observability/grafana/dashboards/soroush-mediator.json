{
  "uid": "soroush-mediator",
  "title": "Soroush Mediator",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "soroush",
    "opentelemetry"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "request",
        "label": "Request",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(soroush_mediator_operation_duration_seconds_count, soroush_mediator_request_name)",
        "query": {
          "query": "label_values(soroush_mediator_operation_duration_seconds_count, soroush_mediator_request_name)",
          "refId": "request"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Operations per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (soroush_mediator_request_name) (rate(soroush_mediator_operation_duration_seconds_count{soroush_mediator_request_name=~\"$request\"}[$__rate_interval]))",
          "legendFormat": "{{soroush_mediator_request_name}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, soroush_mediator_request_name) (rate(soroush_mediator_operation_duration_seconds_bucket{soroush_mediator_request_name=~\"$request\"}[$__rate_interval])))",
          "legendFormat": "{{soroush_mediator_request_name}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Outcomes",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (soroush_mediator_outcome) (increase(soroush_mediator_operation_duration_seconds_count{soroush_mediator_request_name=~\"$request\"}[$__range]))",
          "legendFormat": "{{soroush_mediator_outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active operations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (soroush_mediator_request_name) (soroush_mediator_operation_active{soroush_mediator_request_name=~\"$request\"})",
          "legendFormat": "{{soroush_mediator_request_name}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Stage latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, soroush_mediator_stage) (rate(soroush_mediator_stage_duration_seconds_bucket{soroush_mediator_request_name=~\"$request\"}[$__rate_interval])))",
          "legendFormat": "{{soroush_mediator_stage}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Stream producer latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(soroush_mediator_stream_producer_duration_seconds_bucket{soroush_mediator_request_name=~\"$request\"}[$__rate_interval])))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "title": "Time to first stream item p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(soroush_mediator_stream_time_to_first_item_seconds_bucket{soroush_mediator_request_name=~\"$request\"}[$__rate_interval])))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 8,
      "title": "Stream items per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(soroush_mediator_stream_items_total{soroush_mediator_request_name=~\"$request\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 9,
      "title": "Collector failed exports",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (__name__) (rate({__name__=~\"otelcol_exporter_send_failed_(spans|log_records|metric_points)(_total)?\"}[$__rate_interval]))",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Suppressed diagnostics callback failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "soroush_mediator_diagnostics_failures_total",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 11,
      "title": "Mediator summary logs (open TraceID for trace)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"soroush-diagnostics-demo\"} |= \"Mediator operation completed\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true
      }
    }
  ]
}
