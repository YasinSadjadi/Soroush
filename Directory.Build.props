<Project>
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <Version>0.2.0</Version>
    <Authors>Soroush Contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <PackageTags>dotnet;backend;mediator</PackageTags>
    <IsPackable>false</IsPackable>
    <IsPackable Condition="'$(MSBuildProjectName)' == 'Soroush.Mediator' Or
                           '$(MSBuildProjectName)' == 'Soroush.Mediator.Abstractions' Or
                           '$(MSBuildProjectName)' == 'Soroush.Mediator.Analyzers' Or
                           '$(MSBuildProjectName)' == 'Soroush.Mediator.Diagnostics'">true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>

